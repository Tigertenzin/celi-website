<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — My Site</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  {% assign pageDescription = description | default: subtitle | default: site.description %}
  {%- comment -%} A wide banner makes the best link preview; then the icon; then a screenshot. {%- endcomment -%}
  {% assign ogImage = bannerShare | default: banner | default: icon %}
  {% unless ogImage %}
    {% if screenshots and screenshots.size > 0 %}
      {% assign ogImage = screenshots[0] %}
    {% endif %}
  {% endunless %}
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">

  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{% if page.url contains '/posts/' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if ogImage %}<meta property="og:image" content="{{ site.url }}{{ ogImage }}">{% endif %}

  <meta name="twitter:card" content="{% if ogImage %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  {% if ogImage %}<meta name="twitter:image" content="{{ site.url }}{{ ogImage }}">{% endif %}
  <script>
    (function () {
      var stored = localStorage.getItem("theme");
      if (stored === "light" || stored === "dark") {
        document.documentElement.setAttribute("data-theme", stored);
      }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v={{ styleVersion }}">
</head>
<body>
  <header>
    <a class="site-brand" href="/">
      <img src="/favicon.svg" alt="" class="site-icon">
      <span class="site-name">{{ site.name }}</span>
    </a>
    <nav>
      <a href="/">Home</a>
      <a href="/posts/">Blog</a>
      <a href="/projects/">Projects</a>
      <a href="/links/">About</a>
    </nav>
  </header>

  <main>
    {%- comment -%} An optional `banner:` across the top, as an App Store product page has. {%- endcomment -%}
    {% if banner %}<img class="page-banner" src="{{ banner }}" alt="{{ bannerAlt }}">{% endif %}
    {% unless hideTitle %}
    <div class="page-header{% if icon %} page-header--icon{% endif %}">
      {% if icon %}<img class="app-icon" src="{{ icon }}" alt="">{% endif %}
      <h1>{{ title }}</h1>
      {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
    </div>
    {% endunless %}
    {%- comment -%} A page with an `updated:` date shows when it started and when it last changed. {%- endcomment -%}
    {% if date %}<p class="date">{% if updated %}Started {{ date | readableDate }} · Last updated {{ updated | readableDate }}{% else %}{{ date | readableDate }}{% endif %}</p>{% endif %}
    {{ content }}
  </main>

  <footer>
    <div class="footer-bar">
      <nav class="footer-nav">
        <a href="/">Home</a>
        <a href="/posts/">Blog</a>
        <a href="/projects/">Projects</a>
        <a href="/links/">About</a>
        <a href="/feed.xml">RSS</a>
      </nav>
      <button id="theme-toggle" aria-label="Toggle color theme"></button>
    </div>
  </footer>

  <dialog id="lightbox" class="lightbox">
    <button type="button" id="lightbox-close" class="lightbox-close" aria-label="Close">&times;</button>
    <img id="lightbox-img" src="" alt="">
  </dialog>

  <script>
    (function () {
      var dialog = document.getElementById("lightbox");
      var img = document.getElementById("lightbox-img");
      var closeBtn = document.getElementById("lightbox-close");

      document.addEventListener("click", function (e) {
        var item = e.target.closest(".gallery-item");
        if (!item) return;
        img.src = item.dataset.full;
        img.alt = item.dataset.alt || "";
        dialog.showModal();
      });

      closeBtn.addEventListener("click", function () {
        dialog.close();
      });

      dialog.addEventListener("click", function (e) {
        if (e.target === dialog) dialog.close();
      });

      dialog.addEventListener("close", function () {
        img.src = "";
      });
    })();
  </script>

  <script>
    // Device galleries: keep each row's edge fades and arrows in step with where it's scrolled
    // to, and scroll it by most of a screen when an arrow is pressed.
    (function () {
      var panels = document.querySelectorAll(".device-gallery-panel");
      if (!panels.length) return;

      function update(panel) {
        var track = panel.querySelector(".device-gallery-track");
        var max = track.scrollWidth - track.clientWidth;
        panel.classList.toggle("can-scroll-left", track.scrollLeft > 4);
        panel.classList.toggle("can-scroll-right", max > 4 && track.scrollLeft < max - 4);
      }

      function updateAll() {
        panels.forEach(update);
      }

      panels.forEach(function (panel) {
        var track = panel.querySelector(".device-gallery-track");
        track.addEventListener("scroll", function () { update(panel); }, { passive: true });
        panel.querySelectorAll(".device-gallery-arrow").forEach(function (arrow) {
          arrow.addEventListener("click", function () {
            track.scrollBy({ left: Number(arrow.dataset.scroll) * track.clientWidth * 0.8, behavior: "smooth" });
          });
        });
      });

      // A panel has no size while hidden, so check again when another device is chosen.
      document.querySelectorAll(".device-gallery-input").forEach(function (input) {
        input.addEventListener("change", updateAll);
      });
      window.addEventListener("resize", updateAll);
      window.addEventListener("load", updateAll);
      updateAll();
    })();
  </script>

  <script>
    (function () {
      var root = document.documentElement;
      var btn = document.getElementById("theme-toggle");
      var mql = window.matchMedia("(prefers-color-scheme: dark)");

      function currentTheme() {
        var attr = root.getAttribute("data-theme");
        if (attr === "light" || attr === "dark") return attr;
        return mql.matches ? "dark" : "light";
      }

      function render() {
        var theme = currentTheme();
        btn.textContent = theme === "dark" ? "☀️" : "🌙";
        btn.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
      }

      btn.addEventListener("click", function () {
        var next = currentTheme() === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
        render();
      });

      mql.addEventListener("change", function () {
        if (!localStorage.getItem("theme")) render();
      });

      render();
    })();
  </script>
</body>
</html>
